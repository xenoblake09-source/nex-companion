<?xml version="1.0" encoding="utf-8"?>
<!--
    NEX main screen.

    Layout intent: the animation stage is the hero (NEX's face), the honest state line sits
    right under it, and every control that touches a permission is labelled with what it does.
    A ScrollView keeps everything reachable at large font scales.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nex_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Nex.Title" />

        <TextView
            android:id="@+id/appSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/app_subtitle"
            android:textAppearance="@style/TextAppearance.Nex.Subtitle" />

        <!-- Animation stage: NEX's face. The camera preview shares this stage and is
             only visible while a vision question is actually running. -->
        <FrameLayout
            android:id="@+id/animationStage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/animation_size"
            android:layout_marginTop="14dp">

            <com.nexora.robot.ui.NexAnimationView
                android:id="@+id/animationView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/animation_content_description"
                android:importantForAccessibility="yes" />

            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                tools:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/animationNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Nex.Dim"
            tools:text="7 · Listening pulse" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_status_pill"
            android:gravity="center"
            android:minHeight="44dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:textAppearance="@style/TextAppearance.Nex.Status"
            tools:text="Listening for “Hello NEX”." />

        <TextView
            android:id="@+id/recoveryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/row_gap"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Nex.Dim"
            android:textColor="@color/nex_warn"
            android:visibility="gone"
            tools:text="VOICE SERVICE RECOVERING — PLEASE WAIT"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/cameraStateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/row_gap"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.Nex.Dim"
            android:textColor="@color/nex_error"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_camera_dot"
            tools:text="@string/camera_in_use"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/permissionStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/row_gap"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Nex.Dim"
            tools:text="@string/permission_status_denied" />

        <TextView
            android:id="@+id/backendStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Nex.Dim"
            tools:text="@string/backend_checking" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/voiceToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.4"
                android:text="@string/voice_start" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/visionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/vision_button" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/row_gap"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/galleryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.3"
                android:text="@string/gallery_button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/memoryToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/memory_toggle" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/memoryPanel"
            style="@style/Widget.Nex.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/memoryConsentSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/memory_consent_label"
                android:textAppearance="@style/TextAppearance.Nex.Body"
                android:textColor="@color/nex_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/memory_consent_hint"
                android:textAppearance="@style/TextAppearance.Nex.Dim" />

            <TextView
                android:id="@+id/memoryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.Nex.Body"
                tools:text="Remembered on this device (2 of 24)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearMemoryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/memory_clear" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/hindiSwitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/hindi_switch"
                android:textAppearance="@style/TextAppearance.Nex.Dim"
                android:textColor="@color/nex_text" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/reduceMotionSwitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/reduce_motion_switch"
                android:textAppearance="@style/TextAppearance.Nex.Dim"
                android:textColor="@color/nex_text" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkServerButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/backend_refresh" />

        <!-- Single-line info strip: focus timer countdown, then completion. -->
        <TextView
            android:id="@+id/timerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Nex.Status"
            android:textColor="@color/nex_accent"
            android:visibility="gone"
            tools:text="Focus timer running · 24:59 left"
            tools:visibility="visible" />

        <!-- Single-line notices that NEX wants the user to see as well as hear. -->
        <TextView
            android:id="@+id/noticeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:gravity="center"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.Nex.Dim"
            android:textColor="@color/nex_privacy"
            android:visibility="gone"
            tools:text="I can remember that on this device, but I need your permission first."
            tools:visibility="visible" />

        <TextView
            android:id="@+id/sourcesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.Nex.Dim"
            android:textColor="@color/nex_ok"
            android:textIsSelectable="true"
            android:visibility="gone"
            tools:text="Sources (2)"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/transcriptText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.Nex.Transcript"
            android:textIsSelectable="true"
            tools:text="You: hello NEX\nNEX: Hi! I’m listening." />

        <TextView
            android:id="@+id/privacyNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/permissions_never_requested"
            android:textAppearance="@style/TextAppearance.Nex.Dim" />

        <TextView
            android:id="@+id/wakePhraseNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/wake_phrase_hint"
            android:textAppearance="@style/TextAppearance.Nex.Dim" />
    </LinearLayout>
</ScrollView>
