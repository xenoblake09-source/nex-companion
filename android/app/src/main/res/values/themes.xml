<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Nex" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/nex_primary</item>
        <item name="colorSecondary">@color/nex_accent</item>
        <item name="android:colorBackground">@color/nex_background</item>
        <item name="android:windowBackground">@color/nex_background</item>
        <item name="android:statusBarColor">@color/nex_background</item>
        <item name="android:navigationBarColor">@color/nex_background</item>
        <item name="android:textColorPrimary">@color/nex_text</item>
        <item name="android:textColorSecondary">@color/nex_text_dim</item>
        <item name="materialButtonStyle">@style/Widget.Nex.Button</item>
    </style>

    <style name="Widget.Nex.Button" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textColor">@color/nex_text</item>
        <item name="cornerRadius">22dp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.Nex.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/nex_text</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Nex.Subtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/nex_text_dim</item>
    </style>

    <style name="TextAppearance.Nex.Status" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/nex_primary</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="TextAppearance.Nex.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/nex_text</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="TextAppearance.Nex.Dim" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/nex_text_dim</item>
    </style>

    <style name="Widget.Nex.Panel">
        <item name="android:background">@drawable/bg_panel</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="Widget.Nex.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/nex_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Accessibility: honour the user's font scale, never clip the transcript. -->
    <style name="TextAppearance.Nex.Transcript" parent="TextAppearance.Material3.BodyMedium" tools:ignore="UnusedResources">
        <item name="android:textColor">@color/nex_text</item>
        <item name="android:lineSpacingExtra">6dp</item>
    </style>
</resources>
